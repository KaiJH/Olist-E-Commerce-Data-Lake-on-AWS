export AWS_PROFILE=olist
export AWS_REGION=us-east-2
export AWS_DEFAULT_REGION=us-east-2

export JAVA_HOME=$HOME/Library/Java/JavaVirtualMachines/jbr-17.0.14/Contents/Home

export OLIST_SRC=/path/to/olist/csv/folder   # folder with the 9 Olist CSV files from Kaggle

export BATCH1_DATE=2026-10-01
export BATCH2_DATE=2026-10-02
export DRILL_DATE=2026-10-03

ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"
if [ -n "$ACCOUNT_ID" ]; then
    export ACCOUNT_ID
    export BUCKET="olist-lake-${ACCOUNT_ID}-use2"
    echo "AWS account ${ACCOUNT_ID} | bucket ${BUCKET} | region ${AWS_REGION}"
else
    echo "Not signed in to AWS yet. Later run: aws sso login --profile olist"
fi

